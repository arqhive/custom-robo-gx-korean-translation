{
 "translations": {
  "4E6167": "「확실히 어떤 곳에서 {01}나노 머신{04} 주사를 맞긴 했지만…{08} {01}니카이도{04}라는 건 모르겠군.」{07}",
  "4E61B2": "유스케{05}",
  "4E61BA": "「이 녀석…!」{07}",
  "4E61CF": "히토미{05}",
  "4E61D6": "「{02}마모루{04} 씨한테 도움을 청할까?」{07}",
  "4E61F9": "로버트{05}",
  "4E6202": "「너희, {02}경찰대{04} 졸개냐?{08}　뭐 하는 놈들인지 모르겠지만 날 의심해 봤자 소용없어.」{07}",
  "4E623C": "「의심스러우면 {02}경찰대{04}를 불러도 상관없다고.」{07}",
  "4E6268": "유스케{05}",
  "4E6270": "「정말 모르는 건가 이 녀석…」{08}",
  "4E6340": "유스케{05}",
  "4E6348": "「그럼 {01}참가증{04}에 대해선 알아?」{07}",
  "4E6371": "로버트{05}",
  "4E637A": "「{01}참가증{04}?{08}　아아, 어둠의 대회 {01}참가증{04}이라면 갖고 있지.」{07}",
  "4E63B0": "「갖고 싶냐.{08}뭣하면 {01}한 장{04} 줘도 되는데.」{07}",
  "4E63E0": "유스케{05}",
  "4E63E8": "「진짜?」{07}",
  "4E63FD": "로버트{05}",
  "4E6406": "「단, {01}조건{04}이 있다.」{08}",
  "4E6435": "로버트{05}",
  "4E643E": "「{01}조건{04}을 못 받아들이겠다면 {02}참가증{04}은 못 주지.」{08}",
  "4E6488": "로버트{05}",
  "4E6491": "「몇 번을 물어도 모르는 건 몰라.」{07}",
  "4E64B0": "「난 나쁜 짓은 안 했어.{08}{02}스파이{04}도 아니고.」{08}",
  "4E64E2": "로버트{05}",
  "4E64EB": "「모른다고 했잖아.」{08}",
  "4E6524": "유스케{05}",
  "4E652C": "「조건이라는 게 뭔데?」{07}",
  "4E6549": "로버트{05}",
  "4E6552": "「뭐, 간단한 거야.」{07}",
  "4E6566": "「참가증을 주는 대신 {02}『누구한테도 나에 관한 건 일절 말하지 마라』{04}라는 거지.」{07}",
  "4E65A7": "유스케{05}",
  "4E65AF": "「그것만 하면 돼?」{07}",
  "4E65C8": "로버트{05}",
  "4E65D1": "「그래.{08}어쩔래?{08}　조건을 받아들일 거냐?」{08}",
  "4E6605": "로버트{05}",
  "4E660E": "「조건을 받아들일 마음이 생겼냐?」{08}",
  "4E663F": "유스케{05}",
  "4E6647": "「알았어. 조건을 받아들일게.」{07}",
  "4E6662": "로버트{05}",
  "4E666B": "「좋~아, 그럼 이걸 주지.」{08}",
  "4E669B": "로버트{05}",
  "4E66A4": "「알겠지.{08}약속을 어기면 가만 안 둔다.」{08}",
  "4E66D6": "로버트{05}",
  "4E66DF": "「조건을 못 받아들이겠다면 {02}참가증{04}은 못 주지.」{07}",
  "4E6709": "유스케{05}",
  "4E6711": "「{0A}. 여긴 조건을 받아들이는 게 낫지 않아?{08}　{01}참가증{04}을 못 받잖아.」{08}",
  "4E674C": "로버트{05}",
  "4E6755": "「그럼 난 간다.{08}{02}어둠의 배틀장{04}에서 기다리지!」{07}",
  "4E678D": "히토미{05}",
  "4E6794": "「아~ 무서웠다~」{07}",
  "4E67AD": "유스케{05}",
  "4E67B5": "「뭐야, 너 쫄았었냐.」{07}",
  "4E67D2": "히토미{05}",
  "4E67D9": "「그치만 엄청 무서운 얼굴을 하고 있잖아…」{07}",
  "4E67FF": "「근데 말이야, 자기 입으로 {02}『나쁜 짓은 안 했다』{04}고 하면서 왜 {02}『내 얘기는 비밀로 해라』{04}고 한 걸까~?」{07}",
  "4E6852": "「모순이야~」{07}",
  "4E6868": "유스케{05}",
  "4E6870": "「그야 {01}어둠의 배틀{04} 자체가 불법이니까.{08} 그걸로 잡히는 게 무서웠겠지.」{07}",
  "4E68B0": "히토미{05}",
  "4E68B7": "「그렇구나~」{07}",
  "4E68F3": "유스케{05}",
  "4E68FB": "「아, {02}나노 서처{04}가 반응했어. 이런 사람이 {01}스파이{04}야?」{07}",
  "4E6934": "「어이, 너 니카이도 그룹 사람이지?」{07}",
  "4E695E": "아카네{05}",
  "4E6965": "「어? 무슨 소리려나?」{07}",
  "4E6981": "「이건 말이야, {02}나노 머신{04}에 반응하는 기계야.{08}너, 몸에 나노 머신을 넣었지?」{07}",
  "4E69C8": "아카네{05}",
  "4E69CF": "「아아, {01}그 주사{04} 말이구나. 난 {02}『예뻐질 수 있다』{04}고 해서 주사를 맞았을 뿐이야.」{08}",
  "4E6ABF": "아카네{05}",
  "4E6AC6": "「{01}참가증{04}?{08}　아아, {02}어둠의 배틀장{04} 참가증 말이구나.{08}갖고 싶어?」{07}",
  "4E6B04": "유스케{05}",
  "4E6B0C": "「어? 주는 거야?」{07}",
  "4E6B25": "아카네{05}",
  "4E6B2C": "「응, 몇 장 남아서 줘도 되긴 하는데…{08} 공짜로 주는 건 좀.」{07}",
  "4E6B5B": "「300￥이면 어때?」{08}",
  "4E6B84": "아카네{05}",
  "4E6B8B": "「300￥ 낼 마음이 생겼니?」{08}",
  "4E6BCD": "아카네{05}",
  "4E6BD4": "「분명 {02}나노 머신{04} 주사는 맞았지만 그것뿐이야.」{07}",
  "4E6BFB": "「덕분에 피부 상태도 좋아졌거든.」{08}",
  "4E6C24": "아카네{05}",
  "4E6C2B": "「{02}나노 머신{04} 주사를 맞으면 몸속 깊은 데서 힘이 솟아나.」{08}",
  "4E6C7A": "아카네{05}",
  "4E6C81": "「니카이도?{08}　누구야, 그게?{08}　모르겠어.」{07}",
  "4E6CA9": "유스케{05}",
  "4E6CB1": "「시치미 떼지 마.」{07}",
  "4E6CC5": "아카네{05}",
  "4E6CCC": "「그런 말을 들어도…」{07}",
  "4E6CE2": "「난 {02}『예뻐지는 주사를 놔 주는 {01}병원{02}이 있다』{04}고 해서 거기서 주사를 맞았을 뿐이야.」{07}",
  "4E6D34": "유스케{05}",
  "4E6D3C": "「그게 어디 {02}병원{04}인데?」{07}",
  "4E6D5E": "아카네{05}",
  "4E6D65": "「그건 말 못 해.」{07}",
  "4E6D7D": "유스케{05}",
  "4E6D85": "「{01}니카이도 그룹{04} 병원 아니야?」{07}",
  "4E6DAF": "아카네{05}",
  "4E6DB6": "「글쎄.{08}그런지는 모르겠어.」{08}",
  "4E6DDD": "아카네{05}",
  "4E6DE4": "「그 {02}니카이도{04}라는 사람, 잘생겼니?」{08}",
  "4E6E27": "유스케{05}",
  "4E6E2F": "「그럼 계약 성립이네.」{08}",
  "4E6E4E": "아카네{05}",
  "4E6E55": "「어머, 300￥이 없구나.{08}그럼 못 주겠어.」{07}",
  "4E6E81": "유스케{05}",
  "4E6E89": "「그, 그런…{08} 지금 가진 게 없을 뿐이고…」{07}",
  "4E6EB1": "아카네{05}",
  "4E6EB8": "「…는 거짓말이야.{08}{02}300￥{04} 정도는 필요 없어.」{08}",
  "4E6EF9": "아카네{05}",
  "4E6F00": "「그 대신 병원 얘기는 비밀이야.」{07}",
  "4E6F22": "유스케{05}",
  "4E6F2A": "「그, 그건……{08}",
  "4E6F3F": "뭐, 됐어.」{08}",
  "4E6F5A": "아카네{05}",
  "4E6F61": "「그럼 {02}참가증{04}은 못 주겠네.」{07}",
  "4E6F88": "유스케{05}",
  "4E6F90": "「{0A}, 여긴 얌전히 내는 게 낫지 않을까?」{08}",
  "4E6FC1": "아카네{05}",
  "4E6FC8": "「그럼 난 이만 갈게.{08}어둠의 배틀장에서 만나자.」{07}",
  "4E7000": "히토미{05}",
  "4E7007": "「가 버렸네.」{07}",
  "4E701D": "유스케{05}",
  "4E7025": "「{02}참가증{04}은 손에 넣었지만…{08} 음~ {01}스파이{04}는 좀처럼 안 잡히네.」{07}",
  "4E7065": "히토미{05}",
  "4E706C": "「정말 스파이가 아닌 걸까?」{07}",
  "4E708B": "유스케{05}",
  "4E7093": "「스파이라면 그렇게 쉽게 {02}참가증{04}을 주진 않겠지.」{07}",
  "4E70C4": "히토미{05}",
  "4E70CB": "「그렇구나~」{07}",
  "4E70DD": "유스케{05}",
  "4E70E5": "「어쨌든 이걸로 {01}바람의 대회{04}에 참가할 수 있겠네.」{07}",
  "4E710C": "「이 대회가 끝나면 {02}어둠의 배틀장{04}으로 가자.」{07}",
  "4E715B": "유스케{05}",
  "4E7163": "（좋아, 여기서 {01}나노 서처{04} 스위치를 켜고…）{07}",
  "4E7192": "「어라, 이상하네.{08}반응을 안 해?」{07}",
  "4E71B5": "히토미{05}",
  "4E71BC": "「{02}배터리{04} 떨어진 거 아니지~」{07}",
  "4E71DD": "료{05}",
  "4E71E4": "「뭐냐, 그 기계는?」{07}",
  "4E71FF": "유스케{05}",
  "4E7207": "「아, 아무것도 아니야!」{07}",
  "4E7220": "（이상하네, 이 녀석 스파이가 아닌 건가…）{07}",
  "4E7243": "료{05}",
  "4E724A": "「흠, 그렇군. 그게 {01}스파이 탐지기{04}라는 거구나.」{07}",
  "4E727E": "유스케{05}",
  "4E7286": "「무, 무슨 소리야?」{07}",
  "4E729E": "료{05}",
  "4E72A5": "「핫핫핫, 아쉽게 됐네. {02}스파이{04}가 아니라서.」{07}",
  "4E72C8": "「뭐, 됐어.{08}그런 거라면 이걸 너한테 주지.」{08}",
  "4E7306": "유스케{05}"
 }
}
