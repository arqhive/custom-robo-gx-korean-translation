  "4F278F": "엄마{05}",
  "4F2798": "「어머, 왔구나.」{05}",
  "4F27B9": "엄마{05}",
  "4F27C2": "「오늘도 나가니?」{05}",
  "4F2869": "어떻게 할까?{05}",
  "4F2911": "{02}여기서 기록을 볼 수 있나?{04}{07}",
  "4F292D": "파츠 교환을 여기서 할 수 있다.{07}",
  "4F2984": "엄마{05}",
  "4F298D": "「밥 먹을 시간까지는 들어오렴.」{08}",
  "4F29C3": "엄마{05}",
  "4F29CC": "「요즘 늦게 들어오던데 무슨 일 있니?」{07}",
  "4F29F3": "유스케{05}",
  "4F29FB": "「아하하, {02}커스텀 로보{04}에 푹 빠져서요.」{07}",
  "4F2A22": "엄마{05}",
  "4F2A2B": "「그래. 그럼 다행이지만……」{08}",
  "4F2A5E": "엄마{05}",
  "4F2A67": "「{01}경찰대{04}에서 연락 왔을 땐 심장이 멎는 줄 알았단다.」{08}",
  "4F2AB6": "엄마{05}",
  "4F2ABF": "「무슨 일이니, {0A}!　왜 옷이 그렇게 더러워졌어?」{07}",
  "4F2AEB": "유스케{05}",
  "4F2AF3": "「아하하, 산 쪽에서 좀 놀다 와서요.」{07}",
  "4F2B16": "엄마{05}",
  "4F2B1F": "「이제 외출 금지야!{08}　…라고 하고 싶지만 넌 말을 안 듣겠지.」{07}",
  "4F2B52": "「알았어. 네가 믿는 길을 가렴. 부디 무리는 하지 말고.」{08}",
  "4F2B96": "엄마{05}",
  "4F2B9F": "「{01}히토미{04}가 돌아와서 다행이구나.」{07}",
  "4F2BBF": "「어떻게 될까 걱정했는데,」{08}",
  "4F2BE0": "엄마{05}",
  "4F2BE9": "「정말, {0A}도 참. 한번 빠지면 그것밖에 모른다니까… 우후후」{07}",
  "4F2C14": "「가끔은 집에 와서 건강한 얼굴 보여 주렴.」{08}",
  "4F2C95": "유스케{05}",
  "4F2C9D": "「다음엔 어디로 갈까?」",
  "4F2D75": "유스케{05}",
  "4F2D7D": "「음~ 돈은 없지만… 구경이나 하러 갈까.」",
  "4F2DAD": "유스케{05}",
  "4F2DB5": "「이 돈으로 뭘 살 수 있을까.」",
  "4F2DE0": "유스케{05}",
  "4F2DE8": "「돈도 모였겠다. 자, 뭘 살까.」",
  "4F2E0C": "유스케{05}",
  "4F2E14": "「와하하, 돈은 왕창 있으니까!　가게째로 살까?」",
  "4F2EA7": "접수원{05}",
  "4F2EAF": "「어서 오세요. 무슨 용건이십니까?」{05}",
  "4F2ED5": "접수원{05}",
  "4F2EDD": "「무슨 용건이십니까?」{05}",
  "4F2F69": "접수원{05}",
  "4F2F71": "「{01}마모루{04} 씨도 {01}서장{04}님도 계세요.」{07}",
  "4F2F91": "「요즘 {01}서장{04}님이 {02}쓸쓸해 보이시니까{04} 얼굴 좀 보여 주세요.」{08}",
  "4F2FC4": "접수원{05}",
  "4F2FCC": "「아쉽지만 {01}마모루{04} 씨도 {01}서장{04}님도 안 계세요.」{07}",
  "4F2FF3": "「{01}서장{04}님은 경찰대 본부에서 상층부에 계속 {01}항의{04}하고 계신 것 같아서…」{08}",
  "4F308A": "마모루{05}",
  "4F3091": "「어서 와.」{05}",
  "4F317E": "마모루{05}",
  "4F3185": "「무슨 일 있으면 연락할게.」{08}",
  "4F31A6": "마모루{05}",
  "4F31AD": "「{0A} 군 실력이라면 {01}그레이트 로보 컵{04} 우승도 꿈이 아닐 거야.」{08}",
  "4F3203": "마모루{05}",
  "4F320A": "「{01}배틀{04}은 열심히 하고 있어?」{07}",
  "4F3223": "「아무리 해도 못 이기는 상대가 있으면 {01}커스터마이즈를 바꿔 보는{04} 것도 한 방법이야.」{07}",
  "4F325D": "「지금까지 못 이겼던 상대라도 {01}커스터마이즈를 바꾸{04}면 의외로 쉽게 이기기도 해…{08} 이런 일은 흔하지.」{08}",
  "4F32CC": "「스스로 {01}『이거다』{04} 싶은 {02}커스터마이즈{04}를 정했으면 일단 그걸로 {01}밀고 나가는{04} 방법도 있어.」{07}",
  "4F3316": "「{02}커스터마이즈{04}를 자꾸 바꾸기만 하면 좀처럼 {01}자기 스타일{04}이 몸에 안 붙어.」{07}",
  "4F334C": "「하지만 막히면 새 {02}커스터마이즈{04}나 {02}전법{04}을 시험해 보는 것도 중요해.」{07}",
  "4F338D": "유스케{05}",
  "4F3395": "「에~ 어느 쪽이에요?{08}　{02}커스터마이즈{04}를 안 바꾸는 거예요, 바꾸는 거예요…」{07}",
  "4F33CF": "마모루{05}",
  "4F33D6": "「후후후.{08}어느 쪽이라고는 할 수 없어…{08} 결국은 {01}밸런스{04}야.」{07}",
  "4F33FF": "「그게 {02}커스텀 로보{04}의 {01}심오한{04} 점이지.」{08}",
  "4F3449": "「{01}만능{04} {02}커스터마이즈{04}는 존재하지 않는다…{08} 이렇게 생각해도 좋아.」{07}",
  "4F347B": "「어떤 커스터마이즈든 반드시 {01}약점{04}이 있어.{08}커스터마이즈에는 {01}상성{04}이 있거든.」{07}",
  "4F34C1": "「어떤 {02}커스터마이즈{04}에는 강해도 다른 {02}커스터마이즈{04}에는 약하다……{08} 이게 보통이야.」{07}",
  "4F34FD": "「가위바위보 같은 거라고 생각하면 돼.」{08}",
  "4F353F": "유스케{05}",
  "4F3547": "「{02}마모루{04} 씨는 그레이트 로보 컵 {01}3년 연속{04} 챔피언이죠.」{07}",
  "4F3579": "「어떻게 하면 {02}마모루{04} 씨처럼 될 수 있어요?」{07}",
  "4F35A4": "마모루{05}",
  "4F35AB": "「후후후, 알려 줄까?」{07}",
  "4F35C8": "유스케{05}",
  "4F35D0": "「앗!{08}　어떻게 하면 돼요?」{07}",
  "4F35F1": "마모루{05}",
  "4F35F8": "「그건 말이지, {01}연습{04}뿐이야.」{07}",
  "4F3619": "유스케{05}",
  "4F3621": "「뭐야~」{07}",
  "4F3634": "마모루{05}",
  "4F363B": "「나도 {01}마법{04}처럼 잘하게 된 건 아니야.」{07}",
  "4F3662": "「처음엔 {01}봄{04}도 제대로 못 썼고 아무한테도 못 이겼어.」{07}",
  "4F3690": "「굳이 말하자면 난 {01}연습{04}을 거듭해서 잘하게 된 타입이야.」{07}",
  "4F36C7": "유스케{05}",
  "4F36CF": "「와~」{07}",
  "4F36DF": "마모루{05}",
  "4F36E6": "「잘하고 싶으면 꾸준히 {01}연습{04}하는 수밖에 없어.」{08}",
  "4F3723": "마모루{05}",
  "4F372A": "「{02}커스텀 로보{04}를 잘하고 싶다면…」{07}",
  "4F374A": "「자기한테 맞는 {02}커스터마이즈{04}를 연구해서 그 {02}커스터마이즈{04}로 몇 번이고 {01}배틀{04}을 해 봐.」{07}",
  "4F378A": "「그 {02}커스터마이즈{04}에 한계를 느끼면 {01}커스터마이즈{04}를 바꿔서 시험해 보고.{08}그걸 반복하는 거야.」{08}",
  "4F37DB": "경찰대 대원{05}",
  "4F37E6": "「어이, {01}마모루{04}는 없다.」{05}",
  "4F3865": "경찰대 대원{05}",
  "4F3870": "「까까머리!{08}　{01}마모루{04}는 없다.」{07}",
  "4F388D": "「{02}『내 힘으로 어떻게든 하겠다』{04}면서 계속 나가 있어.」{07}",
  "4F38C3": "유스케{05}",
  "4F38CB": "「{01}마모루{04} 씨 없구나…」{08}",
  "4F38F2": "경찰대 대원{05}",
  "4F38FD": "「{01}까까머리{04}!{08}　가끔은 아저씨랑 놀아 볼래?」{07}",
  "4F392A": "유스케{05}"
 }
